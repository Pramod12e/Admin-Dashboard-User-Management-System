
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All user</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            border-radius: 10px;
            overflow: hidden;
            }

            th {
            background: #e2e8f0;
            padding: 10px;
            text-align: left;
            }

            td {
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
            }
            button{
                background-color: blue;
                color:white;
                border-radius:10px;
            }

            /* pop up */
            .popup {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                }

                .popup-box {
                background: white;
                width: 280px;
                padding: 20px;
                border-radius: 8px;
                margin: 15% auto;
                text-align: center;
                }
                .popup-box input,
                .popup-box textarea {
                width: 100%;
                margin: 10px 0;
                padding: 8px;
                box-sizing: border-box;
                }



                .close {
                float: right;
                cursor: pointer;
                font-size: 20px;
                }
    </style>
    <script>
        /////popup for delete
        function openPopup() {
            document.getElementById("popup").style.display = "block";
        }

        function closePopup() {
            document.getElementById("popup").style.display = "none";
        }

        //////pop up for edit
        function openEditPopup(id, username, email) {
        document.getElementById("editPopup").style.display = "block";

        document.getElementById("editUsername").value = username;
        document.getElementById("userEmail").innerText = "Editing: " + email;

        // set backend route dynamically
        document.getElementById("editForm").action = "/user/" + id + "?_method=PATCH";
        }

        function closeEditPopup() {
        document.getElementById("editPopup").style.display = "none";
        }

        // close if click outside
        window.onclick = function(e) {
        let popup = document.getElementById("editPopup");
        if (e.target === popup) {
            popup.style.display = "none";
        }
        }
    </script>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>user</th>
            <th>role</th>
            <th>edit</th>
            <th>delete</th>
        </tr>
        <%for(ress of result){%>
            <tr>
                <td><%=ress.id%></td>
                <td><%=ress.emal%></td>
                <td><%=ress.username%></td>
                <td><%=ress.roll%></td>
                <td>
                    <button onclick="openEditPopup('<%= ress.id %>', '<%= ress.username %>', '<%= ress.emal %>')">
                         Edit Username
                    </button>
                    <div id="editPopup" class="popup">
                        <div class="popup-box">

                            <span class="close" onclick="closeEditPopup()">&times;</span>

                            <h3>Edit User</h3>
                            <p id="userEmail"></p>

                            <form id="editForm" method="post">
                            
                            <input type="text" name="username" id="editUsername" required>

                            <input type="password" name="password" placeholder="Enter password" required>

                            <button type="submit">Save Changes</button>
                            <button type="button" onclick="closeEditPopup()">Cancel</button>

                            </form>

                        </div>
                    </div>

                   
                </td>

                <td>
                    <button onclick="openPopup()">Delete User</button>
                    <div id="popup" class="popup">
                    <div class="popup-box">
                        <span class="close" onclick="closePopup()">&times;</span>

                        <form method="post" action="/user/<%= ress.id %>?_method=delete">
                        
                        <h3>Enter Password</h3>

                        <input 
                            type="password" 
                            name="password" 
                            placeholder="Enter password" 
                            required
                        >

                        <button type="submit">Confirm Delete</button>
                        </form>

                    </div>
                    </div>
                </td>
                
            </tr>
        <%}%>
    </table>
</body>
</html>
